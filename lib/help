#!/bin/bash

run_help() {

cat <<EOT
macOS dotfiles - Mark Paluch - https://github.com/mp911de/dotfiles

Usage: $(basename "$0") [options]

Options:
    -h, --help      Print this help text
    -f, --force     Replace existing local dotfiles (repo wins)
    --no-packages   Suppress package updates
    --no-sync       Suppress pulling from the remote repository

Without --force, existing local files are left alone and reported.
EOT

}
