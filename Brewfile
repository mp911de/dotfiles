# Homebrew packages for a new machine, applied with `brew bundle install`
# (the `dotfiles` command runs this).

brew "bash"            # brewed bash, added to /etc/shells by `dotfiles`
brew "bash-completion"
brew "cmake"
brew "coreutils"       # GNU core utilities, PATH wired up in zsh_paths
brew "git"
brew "git-lfs"         # gitconfig configures the LFS filters
brew "htop"
brew "tree"
brew "wget"

# Apps
cask "sourcetree"      # gitconfig uses its opendiff wrapper as mergetool
