# Apache Maven, installed from the binary distribution.

MAVEN_VERSION=3.9.16
maven_directory="$DEVTOOLS_HOME/apache-maven-$MAVEN_VERSION"

install_maven() {
    if [[ -d "$maven_directory" ]]; then
        e_success "Maven ${MAVEN_VERSION} installed"
        return 0
    fi

    e_header "Installing Maven ${MAVEN_VERSION}..."
    if curl -sSL "https://repo1.maven.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz" | tar xz -C "$DEVTOOLS_HOME" \
        && chmod a+x "$maven_directory/bin/mvn" "$maven_directory/bin/mvnDebug"; then
        e_success "Maven ${MAVEN_VERSION} installed"
    else
        e_error "Maven ${MAVEN_VERSION} installation failed"
    fi
}
