typeset -U path

for dir in /usr/local/bin /opt/homebrew/bin; do
    [[ -d $dir ]] && path=($dir $path)
done

for dir in \
    "$HOME/bin" \
    "$HOME/.dotfiles/bin" \
    "$HOME/.local/bin" \
    "$mongodb_directory/bin" \
    "$maven_directory/bin" \
    "$mongosh_directory/bin" \
    "$redis_directory/src" \
    /usr/local/mysql/bin \
    "$BREW_COREUTILS_DIR/libexec/gnubin"; do
    [[ -d $dir ]] && path+=($dir)
done
unset dir
