#!/usr/bin/env bash

DOTFILES="$HOME/.dotfiles"
DOTFILES_REMOTE="https://github.com/mp911de/dotfiles"

usage() {
cat <<EOT
macOS dotfiles - Mark Paluch - $DOTFILES_REMOTE

Usage: $(basename "$0") [options]

Options:
    -h, --help      Print this help text
    -f, --force     Replace existing local files (repo wins), same as DOTFILES_FORCE=true
    --no-packages   Skip Homebrew and dev tool installation
    --no-sync       Skip pulling from the remote repository

Replaced files are moved to a backup directory, undo with dotfiles-rollback.
EOT
}

for opt in "$@"; do
    case $opt in
        -h|--help) usage; exit ;;
        -f|--force) export DOTFILES_FORCE=true ;;
        --no-packages) no_packages=true ;;
        --no-sync) no_sync=true ;;
        *) printf 'Unknown option %s\n\n' "$opt" >&2; usage >&2; exit 1 ;;
    esac
done

if ! xcode-select -p &>/dev/null; then
    printf 'Xcode Command Line Tools are required. Run: xcode-select --install\n' >&2
    exit 1
fi

[[ -d $DOTFILES ]] || git clone "$DOTFILES_REMOTE" "$DOTFILES" || exit 1
cd "$DOTFILES" || exit 1

source lib/common
source lib/banner
print_banner

if [[ $no_sync ]]; then
    log_warning "Skipped dotfiles sync"
else
    log_header "Syncing dotfiles..."
    git pull --rebase origin main
fi

if [[ $no_packages ]]; then
    log_warning "Skipped package installation"
else
    if command -v brew &>/dev/null; then
        log_header "Updating Homebrew..."
        brew update && brew upgrade
    else
        log_header "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [[ -x /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [[ -x /usr/local/bin/brew ]]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    fi

    log_header "Installing Homebrew packages..."
    brew bundle install --file=Brewfile || log_warning "brew bundle reported failures"
    brew cleanup

    bin/devtools
fi

log_header "Linking dotfiles..."
link_file "$DOTFILES/bash/bashrc"       "$HOME/.bashrc"
link_file "$DOTFILES/bash/bash_profile" "$HOME/.bash_profile"
link_file "$DOTFILES/bash/inputrc"      "$HOME/.inputrc"
link_file "$DOTFILES/bash/hushlogin"    "$HOME/.hushlogin"
link_file "$DOTFILES/git/gitattributes" "$HOME/.gitattributes"
link_file "$DOTFILES/git/gitconfig"     "$HOME/.gitconfig"
link_file "$DOTFILES/git/gitignore"     "$HOME/.gitignore"
link_file "$DOTFILES/devtools"          "$HOME/.devtools"

bin/prefs

if command -v brew &>/dev/null; then
    brewed_bash="$(brew --prefix)/bin/bash"
    if [[ -x $brewed_bash ]] && ! grep -qxF "$brewed_bash" /etc/shells; then
        log_header "Adding $brewed_bash to /etc/shells (needs sudo)..."
        sudo sh -c "echo '$brewed_bash' >> /etc/shells"
    fi
    brew list --cask qlstephenswift &>/dev/null || bin/quicklook
fi

if confirm "The next step modifies macOS system defaults."; then
    bin/osxprops
    log_success "macOS defaults applied, some changes need a restart"
else
    log_warning "Skipped macOS defaults"
fi

report_backup
