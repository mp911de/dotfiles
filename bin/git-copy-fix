#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_NAME="$(basename "$0")"
STATE_NAMESPACE="git-copy-fix-state"

# shellcheck source=/Users/mark/.dotfiles/bin/git-port-common.sh
source "$SCRIPT_DIR/git-port-common.sh"

print_help() {
  cat <<EOF
Usage: $SCRIPT_NAME <source-ref> <target-branch> [target-branch ...]
       $SCRIPT_NAME --continue

Replace matching HEAD commits on target branches with a fixed commit from the
current repository.

Options:
  --continue        Continue after resolving cherry-pick conflicts.
  -h, --help        Show this help message

Arguments:
  <source-ref>      Branch, tag, or commit that resolves to the fixed commit.
  <target-branch>   Rewrite this branch when its HEAD commit message matches
                    the source commit message.
  [target-branch ...]
                    Additional branches to check in the order provided.
EOF
}

state_dir() {
  git rev-parse --git-path "$STATE_NAMESPACE"
}

state_file() {
  printf '%s/state.env\n' "$(state_dir)"
}

remaining_file() {
  printf '%s/remaining\n' "$(state_dir)"
}

updated_file() {
  printf '%s/updated\n' "$(state_dir)"
}

ensure_state_dir() {
  mkdir -p "$(state_dir)"
}

write_lines_to_file() {
  local file="$1"
  shift

  : > "$file"

  while [[ $# -gt 0 ]]; do
    printf '%s\n' "$1" >> "$file"
    shift
  done
}

load_remaining_branches() {
  REMAINING_BRANCHES=()

  if [[ -f "$(remaining_file)" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      REMAINING_BRANCHES+=("$line")
    done < "$(remaining_file)"
  fi
}

load_updated_branches() {
  UPDATED_BRANCHES=()

  if [[ -f "$(updated_file)" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      UPDATED_BRANCHES+=("$line")
    done < "$(updated_file)"
  fi
}

append_updated_branch() {
  printf '%s\n' "$1" >> "$(updated_file)"
}

shift_remaining_branch() {
  local tmp

  tmp="$(mktemp)"
  if [[ -f "$(remaining_file)" ]]; then
    tail -n +2 "$(remaining_file)" > "$tmp"
  fi
  mv "$tmp" "$(remaining_file)"
}

write_state() {
  local source_ref_display="$1"
  local source_commit="$2"
  local current_branch="$3"
  shift 3

  ensure_state_dir

  {
    printf 'SOURCE_REF_DISPLAY=%q\n' "$source_ref_display"
    printf 'SOURCE_COMMIT=%q\n' "$source_commit"
    printf 'CURRENT_BRANCH=%q\n' "$current_branch"
  } > "$(state_file)"

  write_lines_to_file "$(remaining_file)" "$@"
}

read_state() {
  [[ -f "$(state_file)" ]] || die "No saved state found. Nothing to continue."
  [[ -f "$(remaining_file)" ]] || die "State is incomplete: missing remaining branch list."

  # shellcheck disable=SC1090
  source "$(state_file)"

  [[ -n "${SOURCE_COMMIT:-}" ]] || die "State is invalid: SOURCE_COMMIT missing."
  [[ -n "${CURRENT_BRANCH:-}" ]] || die "State is invalid: CURRENT_BRANCH missing."
}

clear_state() {
  rm -rf "$(state_dir)"
}

source_message() {
  git log -1 --pretty=%B "$1"
}

head_matches_source_message() {
  local source_commit="$1"
  local source_msg
  local target_msg

  source_msg="$(source_message "$source_commit")"
  target_msg="$(git log -1 --pretty=%B HEAD)"

  [[ "$source_msg" == "$target_msg" ]]
}

print_push_hint() {
  local branch

  load_updated_branches

  if [[ ${#UPDATED_BRANCHES[@]} -eq 0 ]]; then
    return 0
  fi

  printf '  %spush:%s  git push --force-with-lease origin' "$GREY" "$RESET"
  for branch in "${UPDATED_BRANCHES[@]}"; do
    printf ' %s' "$(format_branch "$branch")"
  done
  printf '\n'
}

show_banner() {
  local target_repo="$1"
  local source_ref_display="$2"
  local source_commit="$3"

  local title="${GREY}>_${RESET} ${BOLD_WHITE}git${RESET} ${PURPLE}›${RESET} ${BOLD_WHITE}copy-fix${RESET}"
  local source_val

  if [[ -n "$source_ref_display" ]]; then
    source_val="${source_ref_display}  ${GREY}→${RESET}  ${GREEN}${source_commit:0:8}${RESET}"
  else
    source_val="${GREEN}${source_commit:0:8}${RESET}"
  fi

  print_header "$title" \
    "source:" "$source_val" \
    "target:" "$target_repo"
}

parse_args() {
  CONTINUE_MODE="false"
  POSITIONAL=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --continue)
        CONTINUE_MODE="true"
        shift
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      -*)
        die "Unknown option: $1"
        ;;
      *)
        POSITIONAL+=("$1")
        shift
        ;;
    esac
  done
}

continue_flow() {
  local actual_branch

  read_state
  load_remaining_branches
  init_item_widths "${REMAINING_BRANCHES[@]}"
  show_banner "$(git rev-parse --show-toplevel)" "${SOURCE_REF_DISPLAY:-}" "$SOURCE_COMMIT"
  log_info "Resuming cherry-pick on $(format_branch "$CURRENT_BRANCH")."

  actual_branch="$(git_current_branch)"
  [[ "$actual_branch" == "$CURRENT_BRANCH" ]] || die "State expects $(format_branch "$CURRENT_BRANCH"), but you are on $(format_branch "$actual_branch")."

  has_unresolved_conflicts && die "Conflicts still exist. Resolve them, run 'git add <files>', then run '$SCRIPT_NAME --continue'."
  git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1 || die "No cherry-pick appears to be in progress."

  git cherry-pick --continue
  append_updated_branch "$CURRENT_BRANCH"
  shift_remaining_branch
  _OK=$((_OK+1)); _TOT=$((_TOT+1))
  print_item "$CURRENT_BRANCH" "resumed" "$GREEN" "✓" "$GREEN"
}

process_branches() {
  local source_ref="$1"
  local source_commit="$2"
  shift 2

  local branches=("$@")
  local idx
  local branch

  for idx in "${!branches[@]}"; do
    branch="${branches[$idx]}"

    ensure_clean_worktree

    if ! git switch "$branch" >/dev/null 2>&1; then
      die "Could not switch to target branch $(format_branch "$branch")."
    fi

    write_state "$source_ref" "$source_commit" "$branch" "${branches[@]:$idx}"

    _TOT=$((_TOT+1))

    if ! head_matches_source_message "$source_commit"; then
      shift_remaining_branch
      _OK=$((_OK+1))
      print_item "$branch" "skipped" "$CYAN" "◆" "$BOLD_YELLOW"
      continue
    fi

    git rev-parse --verify HEAD~1 >/dev/null 2>&1 || die "Branch $(format_branch "$branch") does not have a parent commit to reset to."

    git reset --hard HEAD~1 >/dev/null 2>&1

    if ! git cherry-pick "$source_commit"; then
      if git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then
        _ERR=$((_ERR+1))
        print_item "$branch" "conflict" "$RED" "✗" "$RED" \
          "Resolve conflicts, run 'git add', then '$SCRIPT_NAME --continue'."
      else
        _ERR=$((_ERR+1))
        print_item "$branch" "failed" "$RED" "✗" "$RED" "Cherry-pick failed."
        clear_state
      fi
      exit 1
    fi

    append_updated_branch "$branch"
    shift_remaining_branch
    _OK=$((_OK+1))
    print_item "$branch" "applied" "$GREEN" "✓" "$GREEN"
  done
}

finish_success() {
  load_updated_branches

  print_summary "${#UPDATED_BRANCHES[@]}" "$_TOT" "$_ERR"
  print_push_hint
  clear_state
}

main() {
  local source_ref
  local source_commit
  local target_repo
  local target_branches=()
  _TOT=0
  _OK=0
  _ERR=0

  require_git_repo
  parse_args "$@"

  if [[ "$CONTINUE_MODE" == "true" ]]; then
    [[ ${#POSITIONAL[@]} -eq 0 ]] || die "--continue cannot be combined with source or target branches."
    continue_flow

    if [[ ${#REMAINING_BRANCHES[@]} -gt 0 ]]; then
      process_branches "${SOURCE_REF_DISPLAY:-}" "$SOURCE_COMMIT" "${REMAINING_BRANCHES[@]}"
    fi

    finish_success
    return
  fi

  if [[ ${#POSITIONAL[@]} -lt 2 ]]; then
    print_help
    exit 1
  fi

  ensure_clean_worktree
  clear_state

  source_ref="${POSITIONAL[0]}"
  target_branches=("${POSITIONAL[@]:1}")

  if ! git rev-parse --verify "${source_ref}^{commit}" >/dev/null 2>&1; then
    die "Could not resolve '$source_ref' as a commit."
  fi
  source_commit="$(git rev-parse --verify "${source_ref}^{commit}")"
  target_repo="$(git rev-parse --show-toplevel)"

  ensure_state_dir
  : > "$(updated_file)"

  init_item_widths "${target_branches[@]}"
  show_banner "$target_repo" "$source_ref" "$source_commit"
  process_branches "$source_ref" "$source_commit" "${target_branches[@]}"
  finish_success
}

main "$@"
