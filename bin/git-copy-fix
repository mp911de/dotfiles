#!/usr/bin/env python3
"""Replace matching HEAD commits on target branches with a fixed commit.

Given a fixed commit in the current repository and one or more target branches,
the command rewrites each branch whose HEAD commit message matches the fixed
commit: it drops the branch's HEAD commit and cherry-picks the fixed commit in
its place. Branches whose HEAD message does not match are left untouched.

When a cherry-pick conflicts the run stops and saves its progress; rerunning with
``--continue`` resumes from the interrupted branch after the conflict is
resolved.
"""

from __future__ import annotations

import os
import sys
from dataclasses import dataclass, field
from typing import List, Optional

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from git_port_common import Console, Git, PortError, StateStore  # noqa: E402

SCRIPT_NAME = os.path.basename(sys.argv[0])
STATE_NAMESPACE = "git-copy-fix-state"

HELP = f"""\
Usage: {SCRIPT_NAME} <source-ref> <target-branch> [target-branch ...]
       {SCRIPT_NAME} --continue

Replace matching HEAD commits on target branches with a fixed commit from the
current repository.

Options:
  --continue        Continue after resolving cherry-pick conflicts.
  -h, --help        Show this help message

Arguments:
  <source-ref>      Branch, tag, or commit that resolves to the fixed commit.
  <target-branch>   Rewrite this branch when its HEAD commit message matches
                    the source commit message.
  [target-branch ...]
                    Additional branches to check in the order provided.
"""


@dataclass
class Arguments:
    continue_mode: bool = False
    positionals: List[str] = field(default_factory=list)


def parse_arguments(argv: List[str]) -> Arguments:
    parsed = Arguments()
    for argument in argv:
        if argument == "--continue":
            parsed.continue_mode = True
        elif argument in ("-h", "--help"):
            print(HELP, end="")
            raise SystemExit(0)
        elif argument.startswith("-"):
            raise PortError(f"Unknown option: {argument}")
        else:
            parsed.positionals.append(argument)
    return parsed


class CopyFix:
    """Drives the rewrite across the target branches and persists its progress.

    The persisted state holds everything ``--continue`` needs: the fixed commit,
    its display reference, the branch interrupted by a conflict, the branches not
    yet processed and the branches already rewritten (for the push hint).
    """

    def __init__(self, console: Console, git: Git) -> None:
        self.console = console
        self.git = git
        self.state = StateStore(git, STATE_NAMESPACE)
        self.applied: List[str] = []
        self.targets: List[str] = []
        self.source_ref = ""
        self.source_commit = ""

    # -- state -----------------------------------------------------------------

    def _save_progress(self, current_branch: str, remaining: List[str]) -> None:
        self.state.save(
            {
                "source_ref": self.source_ref,
                "source_commit": self.source_commit,
                "current_branch": current_branch,
                "remaining": remaining,
                "applied": self.applied,
                "targets": self.targets,
            }
        )

    # -- the rewrite -----------------------------------------------------------

    def _head_matches_source(self) -> bool:
        return self.git.head_message("HEAD") == self.git.head_message(self.source_commit)

    def _process(self, branches: List[str]) -> None:
        a = self.console.ansi
        for index, branch in enumerate(branches):
            self.git.ensure_clean_worktree()
            if not self.git.switch(branch):
                raise PortError(
                    f"Could not switch to target branch {self.console.branch(branch)}."
                )

            self._save_progress(branch, branches[index:])

            if not self._head_matches_source():
                self.console.item(branch, "skipped", a.cyan, "◆", a.bold_yellow)
                continue

            if not self.git.has_ref("HEAD~1"):
                raise PortError(
                    f"Branch {self.console.branch(branch)} does not have a parent "
                    f"commit to reset to."
                )

            self.git.reset_hard("HEAD~1")
            if self.git.interactive("cherry-pick", self.source_commit) != 0:
                self._report_cherry_pick_failure(branch)
                raise SystemExit(1)

            self.applied.append(branch)
            self.console.item(branch, "applied", a.green, "✓", a.green)

    def _report_cherry_pick_failure(self, branch: str) -> None:
        a = self.console.ansi
        if self.git.cherry_pick_in_progress():
            self.console.item(
                branch, "conflict", a.red, "✗", a.red,
                f"Resolve conflicts, run 'git add', then '{SCRIPT_NAME} --continue'.",
            )
        else:
            self.console.item(branch, "failed", a.red, "✗", a.red, "Cherry-pick failed.")
            self.state.clear()

    # -- resuming --------------------------------------------------------------

    def _resume(self) -> List[str]:
        """Finish the interrupted cherry-pick and return the branches left."""
        a = self.console.ansi
        saved = self.state.load()
        if "remaining" not in saved or "current_branch" not in saved:
            raise PortError("State is invalid: missing branch information.")

        self.source_ref = saved.get("source_ref", "")
        self.source_commit = saved["source_commit"]
        self.applied = saved.get("applied", [])
        self.targets = saved.get("targets", [])
        current_branch = saved["current_branch"]
        remaining = saved["remaining"]

        self.console.reserve_item_width(remaining)
        self.show_banner(self.git.top_level())
        self.console.info(f"Resuming cherry-pick on {self.console.branch(current_branch)}.")

        actual_branch = self.git.current_branch()
        if actual_branch != current_branch:
            raise PortError(
                f"State expects {self.console.branch(current_branch)}, "
                f"but you are on {self.console.branch(actual_branch)}."
            )
        if self.git.has_unresolved_conflicts():
            raise PortError(
                f"Conflicts still exist. Resolve them, run 'git add <files>', "
                f"then run '{SCRIPT_NAME} --continue'."
            )
        if not self.git.cherry_pick_in_progress():
            raise PortError("No cherry-pick appears to be in progress.")

        if self.git.interactive("cherry-pick", "--continue") != 0:
            raise PortError("Could not continue the cherry-pick.")

        self.applied.append(current_branch)
        self.console.item(current_branch, "resumed", a.green, "✓", a.green)
        return remaining[1:]

    # -- presentation ----------------------------------------------------------

    def show_banner(self, repository: str) -> None:
        a = self.console.ansi
        title = (
            f"{a.grey}>_{a.reset} {a.bold_white}git{a.reset} {a.purple}›{a.reset} "
            f"{a.bold_white}copy-fix{a.reset}"
        )
        commit = self.console.commit(self.source_commit)
        if self.source_ref:
            source = f"{self.source_ref}  {a.grey}→{a.reset}  {commit}"
        else:
            source = commit
        self.console.header(title, "source:", source, "target:", repository)

    def print_push_hint(self) -> None:
        if not self.applied:
            return
        a = self.console.ansi
        branches = " ".join(self.console.branch(branch) for branch in self.applied)
        sys.stdout.write(
            f"  {a.grey}push:{a.reset}  git push --force-with-lease origin {branches}\n"
        )

    def _finish(self) -> None:
        self.console.summary(len(self.applied), len(self.targets))
        self.print_push_hint()
        self.state.clear()

    # -- entry points ----------------------------------------------------------

    def resume(self) -> None:
        remaining = self._resume()
        if remaining:
            self._process(remaining)
        self._finish()

    def start(self, source_ref: str, target_branches: List[str]) -> None:
        self.git.ensure_clean_worktree()
        self.state.clear()

        commit = self.git.resolve_commit(source_ref)
        if commit is None:
            raise PortError(f"Could not resolve '{source_ref}' as a commit.")

        self.source_ref = source_ref
        self.source_commit = commit
        self.targets = list(target_branches)

        self.console.reserve_item_width(target_branches)
        self.show_banner(self.git.top_level())
        self._process(target_branches)
        self._finish()


def main(argv: List[str]) -> int:
    console = Console()
    git = Git()
    try:
        git.require_repository()
        arguments = parse_arguments(argv)
        command = CopyFix(console, git)

        if arguments.continue_mode:
            if arguments.positionals:
                raise PortError(
                    "--continue cannot be combined with source or target branches."
                )
            command.resume()
            return 0

        if len(arguments.positionals) < 2:
            print(HELP, end="")
            return 1

        command.start(arguments.positionals[0], arguments.positionals[1:])
    except PortError as error:
        console.error(str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
