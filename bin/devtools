#!/usr/bin/env bash

source "$HOME/.dotfiles/lib/common"
source "$DOTFILES/devtools"

if [[ $1 == -h || $1 == --help ]]; then
    printf 'Usage: %s\n\nInstall the pinned dev tools from devtools.d/ into %s.\n' "$(basename "$0")" "$DEVTOOLS_HOME"
    exit
fi

mkdir -p "$DEVTOOLS_HOME"

log_header "Checking dev tools..."
for installer in $(compgen -A function | grep '^install_'); do
    "$installer"
done
