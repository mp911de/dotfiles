#!/bin/bash

DOTFILES_DIRECTORY="${HOME}/.dotfiles"

cd ${DOTFILES_DIRECTORY}

source ./lib/utils
source ./devtools

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<EOT
Install the pinned dev tools into ${DEVTOOLS_HOME}.

Each tool under devtools.d/ pins its version and defines an install
function; already installed versions are skipped.

Usage: $(basename "$0")
EOT
    exit
fi

mkdir -p "$DEVTOOLS_HOME"

e_header "Checking status of desired tools..."
for installer in $(compgen -A function | grep '^install_'); do
    "$installer"
done
