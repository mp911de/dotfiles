#!/usr/bin/env python3
"""Edit the HEAD commit message across several local branches at once.

The command opens the Git-configured editor seeded with the HEAD commit message
of the first branch, then amends the HEAD commit on every listed branch with the
edited message. Before opening the editor it verifies that the subject line of
each branch's HEAD commit matches, so a typo cannot silently rewrite unrelated
commits.
"""

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from typing import List

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from git_port_common import Console, Git, PortError  # noqa: E402

SCRIPT_NAME = os.path.basename(sys.argv[0])

HELP = f"""\
Usage: {SCRIPT_NAME} <branch> [branch ...]

Edit the HEAD commit message across multiple local branches. The script opens the
Git-configured editor with the full HEAD commit message from the first branch,
then amends the HEAD commit on each listed branch with the edited message.

Before opening the editor, the script verifies that the first line of each HEAD
commit message matches across the provided branches. If the check fails, the
script prints each branch and its subject line, then aborts without changing
anything.

Options:
  -h, --help        Show this help message

Arguments:
  <branch>          Local branch whose HEAD commit message should be updated.
  [branch ...]      Additional local branches to rewrite in the order provided.
"""


def parse_branches(argv: List[str]) -> List[str]:
    """Parse the command line into the ordered list of target branches."""
    branches: List[str] = []
    arguments = list(argv)
    while arguments:
        argument = arguments.pop(0)
        if argument in ("-h", "--help"):
            print(HELP, end="")
            raise SystemExit(0)
        if argument == "--":
            branches.extend(arguments)
            break
        if argument.startswith("-"):
            raise PortError(f"Unknown option: {argument}")
        branches.append(argument)
    return branches


class EditMessage:
    """Coordinates the validation, editing and amend steps of the command."""

    def __init__(self, console: Console, git: Git) -> None:
        self.console = console
        self.git = git
        self.updated: List[str] = []

    # -- validation ------------------------------------------------------------

    def validate_branches_exist(self, branches: List[str]) -> None:
        for branch in branches:
            if not self.git.branch_exists(branch):
                raise PortError(f"Local branch does not exist: {branch}")

    def require_matching_subjects(self, branches: List[str]) -> str:
        """Return the shared subject, or abort listing every branch's subject."""
        expected = self.git.head_subject(branches[0])
        if all(self.git.head_subject(branch) == expected for branch in branches):
            return expected

        a = self.console.ansi
        self.console.error(
            "HEAD commit subjects do not match across the provided branches. Aborting."
        )
        for branch in branches:
            self.console.item(
                branch, "mismatch", a.red, "✗", a.red, self.git.head_subject(branch)
            )
        raise SystemExit(1)

    # -- editing ---------------------------------------------------------------

    def edit_message(self, seed: str) -> str:
        """Open the Git editor on ``seed`` and return the cleaned-up result."""
        editor = self.git.editor_command()
        with tempfile.TemporaryDirectory(prefix="git-edit-message-") as workspace:
            draft = os.path.join(workspace, "COMMIT_EDITMSG")
            with open(draft, "w") as handle:
                handle.write(seed)

            environment = {**os.environ, "GIT_EDIT_TARGET": draft}
            exit_code = subprocess.run(
                f'{editor} "$GIT_EDIT_TARGET"', shell=True, env=environment
            ).returncode
            if exit_code != 0:
                raise PortError("Editor exited with a non-zero status.")

            with open(draft) as handle:
                edited = handle.read()

        cleaned = self.git.stripspace(edited)
        if not cleaned.strip():
            raise PortError("Commit message cannot be empty.")
        return cleaned

    # -- amending --------------------------------------------------------------

    def amend(self, branch: str, message: str) -> None:
        a = self.console.ansi
        self.git.ensure_clean_worktree()
        if not self.git.switch(branch):
            raise PortError(f"Could not switch to branch {self.console.branch(branch)}.")
        if not self._amend_with_message(message):
            raise PortError(
                f"Could not amend the HEAD commit message on "
                f"{self.console.branch(branch)}."
            )
        self.updated.append(branch)
        self.console.item(branch, "amended", a.green, "✓", a.green)

    def _amend_with_message(self, message: str) -> bool:
        with tempfile.NamedTemporaryFile(
            "w", prefix="git-edit-message-", suffix=".txt", delete=False
        ) as handle:
            handle.write(message)
            path = handle.name
        try:
            return self.git.amend_with_message_file(path)
        finally:
            os.unlink(path)

    # -- presentation ----------------------------------------------------------

    def show_banner(self, repository: str, subject: str) -> None:
        a = self.console.ansi
        title = (
            f"{a.grey}>_{a.reset} {a.bold_white}git{a.reset} {a.purple}›{a.reset} "
            f"{a.bold_white}amend{a.reset} {a.purple}›{a.reset} {a.bold_white}message{a.reset}"
        )
        self.console.header(title, "repo:   ", repository, "subject:", subject)

    def print_push_hint(self) -> None:
        if not self.updated:
            return
        a = self.console.ansi
        targets = " ".join(self.console.branch(branch) for branch in self.updated)
        sys.stdout.write(f"  {a.grey}push:{a.reset}  git push origin {targets}\n")

    # -- orchestration ---------------------------------------------------------

    def run(self, branches: List[str]) -> None:
        self.git.ensure_clean_worktree()
        self.validate_branches_exist(branches)
        self.console.reserve_item_width(branches)
        subject = self.require_matching_subjects(branches)

        self.show_banner(self.git.top_level(), subject)

        original = self.git.stripspace(self.git.head_message_raw(branches[0]))
        edited = self.edit_message(original)
        if edited == original:
            self.console.info("Commit message unchanged. No branches were updated.")
            return

        for branch in branches:
            self.amend(branch, edited)

        self.console.summary(len(self.updated), len(branches))
        self.print_push_hint()


def main(argv: List[str]) -> int:
    console = Console()
    git = Git()
    try:
        git.require_repository()
        branches = parse_branches(argv)
        if not branches:
            print(HELP, end="")
            return 1
        EditMessage(console, git).run(branches)
    except PortError as error:
        console.error(str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
