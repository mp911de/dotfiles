#!/usr/bin/env python3
"""Cherry-pick one commit onto several target branches.

The command applies a single source commit to each listed branch in turn. The
source may live in the current repository or be fetched from another one with
``-p``. After each cherry-pick the resulting commit message can have its ticket
references rewritten with ``-t`` (e.g. ``#123`` becomes ``#456``).

When a cherry-pick conflicts the run stops and saves its progress. Resolve the
conflict and rerun with ``--continue``, or discard everything with ``--abort``.
"""

from __future__ import annotations

import os
import re
import sys
import tempfile
from dataclasses import dataclass, field
from typing import List, Optional

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from git_port_common import (  # noqa: E402
    Console,
    Git,
    PortError,
    StateStore,
    resolve_directory,
)

SCRIPT_NAME = os.path.basename(sys.argv[0])
STATE_NAMESPACE = "cross-port-state"

HELP = f"""\
Usage: {SCRIPT_NAME} [-p <source-repo>] [-t <new-ticket>] <source-ref> <target-branch> [target-branch ...]
       {SCRIPT_NAME} --continue
       {SCRIPT_NAME} --abort

Cherry-pick one commit onto multiple target branches, optionally fetching the
source commit from another repository and rewriting ticket references in the
resulting commit messages.

Options:
  -p, --path       Path to the source repository. If omitted, source is
                   resolved in the current repository.
  -t, --ticket     Replace ticket references like #123, gh-123, or GH-123 in
                   the last commit message after each cherry-pick.
  --continue       Continue after resolving cherry-pick conflicts.
  --abort          Abort an in-progress cherry-pick and remove saved state.
  -h, --help       Show this help message

Arguments:
  <source-ref>      Branch, tag, or commit that resolves to the source commit.
  <target-branch>   Cherry-pick the source commit onto this branch.
  [target-branch ...]
                    Additional branches to update in the order provided.
"""

# Ticket references recognised in commit messages, each anchored to a word
# boundary so the prefix (``#``, ``gh-`` or ``GH-``) is preserved on rewrite.
_TICKET_PATTERNS = [
    re.compile(r"(^|[^A-Za-z0-9_])" + re.escape(prefix) + r"[0-9]+", re.MULTILINE)
    for prefix in ("#", "gh-", "GH-")
]
_TICKET_PREFIXES = ("#", "gh-", "GH-")


@dataclass
class Arguments:
    source_path: str = ""
    new_ticket: str = ""
    continue_mode: bool = False
    abort_mode: bool = False
    positionals: List[str] = field(default_factory=list)


def parse_arguments(argv: List[str]) -> Arguments:
    parsed = Arguments()
    arguments = list(argv)
    while arguments:
        argument = arguments.pop(0)
        if argument == "--continue":
            parsed.continue_mode = True
        elif argument == "--abort":
            parsed.abort_mode = True
        elif argument in ("-p", "--path"):
            parsed.source_path = _take_value(argument, arguments)
        elif argument.startswith("--path="):
            parsed.source_path = argument.split("=", 1)[1]
        elif argument in ("-t", "--ticket"):
            parsed.new_ticket = _take_value(argument, arguments)
        elif argument.startswith("--ticket="):
            parsed.new_ticket = argument.split("=", 1)[1]
        elif argument in ("-h", "--help"):
            print(HELP, end="")
            raise SystemExit(0)
        elif argument == "--":
            parsed.positionals.extend(arguments)
            break
        elif argument.startswith("-"):
            raise PortError(f"Unknown option: {argument}")
        else:
            parsed.positionals.append(argument)
    return parsed


def _take_value(option: str, arguments: List[str]) -> str:
    if not arguments:
        raise PortError(f"Missing value for {option}.")
    return arguments.pop(0)


def renumber_tickets(message: str, new_ticket: str) -> str:
    """Rewrite every recognised ticket reference in ``message`` to ``new_ticket``."""
    number = new_ticket.lstrip("#")
    updated = message
    for pattern, prefix in zip(_TICKET_PATTERNS, _TICKET_PREFIXES):
        updated = pattern.sub(lambda match: match.group(1) + prefix + number, updated)
    return updated


class Multiport:
    """Drives the cherry-picks across the target branches and persists progress.

    The persisted state captures the source commit, the optional ticket and
    source-repository display strings, the branch interrupted by a conflict, the
    branches not yet processed and the full target list (for the push hint).
    """

    def __init__(self, console: Console, git: Git) -> None:
        self.console = console
        self.git = git
        self.state = StateStore(git, STATE_NAMESPACE)
        self.source_commit = ""
        self.new_ticket = ""
        self.source_ref = ""
        self.source_repo = ""
        self.targets: List[str] = []
        self.applied = 0

    # -- state -----------------------------------------------------------------

    def _save_progress(self, current_branch: str, remaining: List[str]) -> None:
        self.state.save(
            {
                "source_commit": self.source_commit,
                "new_ticket": self.new_ticket,
                "source_ref": self.source_ref,
                "source_repo": self.source_repo,
                "current_branch": current_branch,
                "remaining": remaining,
                "targets": self.targets,
            }
        )

    # -- ticket rewriting ------------------------------------------------------

    def _rewrite_last_commit_ticket(self) -> None:
        if not self.new_ticket:
            return
        message = self.git.head_message("HEAD")
        updated = renumber_tickets(message, self.new_ticket)
        if updated == message:
            self.console.warn(
                "No replaceable ticket reference found in the last commit message."
            )
            return
        with tempfile.NamedTemporaryFile(
            "w", prefix="git-multiport-", suffix=".txt", delete=False
        ) as handle:
            handle.write(updated + "\n")
            path = handle.name
        try:
            self.git.amend_with_message_file(path)
        finally:
            os.unlink(path)

    # -- the cherry-picks ------------------------------------------------------

    def _process(self, branches: List[str]) -> None:
        a = self.console.ansi
        for index, branch in enumerate(branches):
            self.git.ensure_clean_worktree()
            if not self.git.switch(branch):
                raise PortError(
                    f"Could not switch to target branch {self.console.branch(branch)}."
                )

            self._save_progress(branch, branches[index:])
            if index > 0:
                sys.stdout.write("\n")

            result = self.git.capture("cherry-pick", self.source_commit, merge_stderr=True)
            self._echo_cherry_pick_output(result.stdout)

            if result.returncode != 0:
                self._report_cherry_pick_failure(branch)
                raise SystemExit(1)

            self._rewrite_last_commit_ticket()
            self.applied += 1
            self.console.item(branch, "applied", a.green, "✓", a.green)

    def _echo_cherry_pick_output(self, output: str) -> None:
        """Reprint git's cherry-pick output, framed to match the command's style."""
        a = self.console.ansi
        lines = output.splitlines()
        for position, line in enumerate(lines):
            if position == 0:
                sys.stdout.write(f"{a.bold_yellow}◆{a.reset} {line}\n")
            else:
                sys.stdout.write(f"   {a.purple}›{a.reset} {line.lstrip(' ')}\n")

    def _report_cherry_pick_failure(self, branch: str) -> None:
        a = self.console.ansi
        if self.git.cherry_pick_in_progress():
            self.console.item(branch, "conflict", a.red, "✗", a.red)
            self.console.message_box(
                a.orange,
                self._title(),
                f"{a.bold_yellow}Resolve conflicts, run 'git add <files>', "
                f"then '{SCRIPT_NAME} --continue'.{a.reset}",
            )
        else:
            self.console.item(branch, "failed", a.red, "✗", a.red, "Cherry-pick failed.")
            self.state.clear()

    # -- resolving the source --------------------------------------------------

    def resolve_source(self, source_ref: str, source_path: str) -> str:
        """Resolve ``source_ref`` to a commit, fetching from ``source_path`` first."""
        if source_path:
            resolved = resolve_directory(source_path)
            if resolved is None:
                raise PortError(f"Source path does not exist: {source_path}")
            if not Git(cwd=resolved).is_repository():
                raise PortError(f"Source path is not a Git repository: {resolved}")
            if not self.git.fetch(resolved, source_ref):
                raise PortError(f"Could not fetch '{source_ref}' from '{resolved}'.")
            return self.git.text("rev-parse", "--verify", "FETCH_HEAD^{commit}")

        commit = self.git.resolve_commit(source_ref)
        if commit is None:
            raise PortError(f"Could not resolve '{source_ref}' as a branch or commit.")
        return commit

    # -- resuming and aborting -------------------------------------------------

    def _resume(self) -> List[str]:
        a = self.console.ansi
        saved = self.state.load()
        if "remaining" not in saved or "current_branch" not in saved:
            raise PortError("State is invalid: missing branch information.")

        self.source_commit = saved["source_commit"]
        self.new_ticket = saved.get("new_ticket", "")
        self.source_ref = saved.get("source_ref", "")
        self.source_repo = saved.get("source_repo", "")
        self.targets = saved.get("targets", [])
        current_branch = saved["current_branch"]
        remaining = saved["remaining"]

        self.console.reserve_item_width(remaining)
        self.show_banner(self.git.top_level())
        self.console.info(f"Resuming cherry-pick on {self.console.branch(current_branch)}.")

        actual_branch = self.git.current_branch()
        if actual_branch != current_branch:
            raise PortError(
                f"State expects {self.console.branch(current_branch)}, "
                f"but you are on {self.console.branch(actual_branch)}."
            )
        if self.git.has_unresolved_conflicts():
            raise PortError(
                f"Conflicts still exist. Resolve them, run 'git add <files>', "
                f"then run '{SCRIPT_NAME} --continue'."
            )
        if not self.git.cherry_pick_in_progress():
            raise PortError("No cherry-pick appears to be in progress.")

        if self.git.interactive("cherry-pick", "--continue") != 0:
            raise PortError("Could not continue the cherry-pick.")

        self._rewrite_last_commit_ticket()
        self.applied += 1
        self.console.item(current_branch, "resumed", a.green, "✓", a.green)
        return remaining[1:]

    def abort(self) -> None:
        did_anything = False
        if self.git.cherry_pick_in_progress():
            self.git.interactive("cherry-pick", "--abort")
            self.console.info("Aborted in-progress cherry-pick.")
            did_anything = True
        if self.state.directory.is_dir():
            self.state.clear()
            self.console.info("Removed multiport state.")
            did_anything = True
        if not did_anything:
            self.console.info("Nothing to abort.")

    # -- presentation ----------------------------------------------------------

    def _title(self) -> str:
        a = self.console.ansi
        return (
            f"{a.grey}>_{a.reset} {a.bold_white}git{a.reset} {a.purple}›{a.reset} "
            f"{a.bold_white}multiport{a.reset}"
        )

    def show_banner(self, repository: str) -> None:
        a = self.console.ansi
        commit = self.console.commit(self.source_commit)
        if self.source_ref:
            source = f"{self.source_ref}  {a.grey}→{a.reset}  {commit}"
        else:
            source = commit

        if self.source_repo:
            self.console.header(
                self._title(),
                "source:", self.source_repo,
                "commit:", source,
                "target:", repository,
            )
        else:
            self.console.header(
                self._title(), "source:", source, "target:", repository
            )

    def print_push_hint(self) -> None:
        if not self.targets:
            return
        a = self.console.ansi
        branches = " ".join(self.console.branch(branch) for branch in self.targets)
        sys.stdout.write(f"  {a.grey}push:{a.reset}  git push origin {branches}\n")

    def _finish(self) -> None:
        self.console.summary(self.applied, len(self.targets))
        self.print_push_hint()
        self.state.clear()

    # -- entry points ----------------------------------------------------------

    def resume(self) -> None:
        remaining = self._resume()
        if remaining:
            self._process(remaining)
        self._finish()

    def start(self, arguments: Arguments) -> None:
        self.git.ensure_clean_worktree()
        self.state.clear()

        source_ref = arguments.positionals[0]
        self.targets = arguments.positionals[1:]
        self.new_ticket = arguments.new_ticket
        self.source_ref = source_ref

        self.source_commit = self.resolve_source(source_ref, arguments.source_path)
        if arguments.source_path:
            self.source_repo = resolve_directory(arguments.source_path) or ""

        self.console.reserve_item_width(self.targets)
        self.show_banner(self.git.top_level())
        self._process(self.targets)
        self._finish()


def main(argv: List[str]) -> int:
    console = Console()
    git = Git()
    try:
        git.require_repository()
        arguments = parse_arguments(argv)
        command = Multiport(console, git)

        if arguments.continue_mode and arguments.abort_mode:
            raise PortError("--continue and --abort cannot be combined.")

        if arguments.abort_mode:
            _reject_extra_arguments(arguments, "--abort")
            command.abort()
            return 0

        if arguments.continue_mode:
            _reject_extra_arguments(arguments, "--continue")
            command.resume()
            return 0

        if len(arguments.positionals) < 2:
            print(HELP, end="")
            return 1

        command.start(arguments)
    except PortError as error:
        console.error(str(error))
        return 1
    return 0


def _reject_extra_arguments(arguments: Arguments, option: str) -> None:
    if arguments.positionals or arguments.source_path or arguments.new_ticket:
        raise PortError(
            f"{option} cannot be combined with source, target branches, -p, or -t."
        )


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
