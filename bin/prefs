#!/usr/bin/env bash

source "$HOME/.dotfiles/lib/common"

for opt in "$@"; do
    case $opt in
        -f|--force) export DOTFILES_FORCE=true ;;
        -h|--help)
            printf 'Usage: %s [-f|--force]\n\nSymlink application preferences from %s into place.\n' "$(basename "$0")" "$DOTFILES"
            exit ;;
        *) log_error "Unknown option $opt"; exit 1 ;;
    esac
done

if [[ ! -d $HOME/.oh-my-zsh ]]; then
    log_header "Installing oh-my-zsh..."
    git clone https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh" || log_error "Failed to clone oh-my-zsh"
fi

log_header "Linking preferences..."
link_file "$DOTFILES/zsh/zshrc"                    "$HOME/.zshrc"
link_file "$DOTFILES/ghostty"                      "$HOME/.config/ghostty"
link_file "$DOTFILES/ghostty/com.mitchellh.ghostty" "$HOME/Library/Application Support/com.mitchellh.ghostty"
link_file "$DOTFILES/TextMate/Bundles"             "$HOME/Library/Application Support/TextMate/Bundles"
link_file "$DOTFILES/TextMate/Global.tmProperties" "$HOME/Library/Application Support/TextMate/Global.tmProperties"

report_backup
