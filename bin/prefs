#!/bin/bash

DOTFILES="${HOME}/.dotfiles"

source "${DOTFILES}/lib/utils"
source "${DOTFILES}/lib/link"

run_prefs_help() {

cat <<EOT
Symlink application preferences from ${DOTFILES} into place.

Usage: $(basename "$0") [options]

Options:
    -f, --force     Replace existing local files and directories (repo wins)
    -h, --help      Print this help text
EOT

}

force=false

for opt in "$@"
do
    case $opt in
        -f|--force) force=true ;;
        -h|--help) run_prefs_help; exit ;;
        *) e_warning "Warning: invalid option $opt" ;;
    esac
done

# zshrc requires oh-my-zsh; keep the clone pristine, customizations live in this repo
if [[ ! -d "${HOME}/.oh-my-zsh" ]]; then
    e_header "Installing oh-my-zsh..."
    if git clone https://github.com/ohmyzsh/ohmyzsh.git "${HOME}/.oh-my-zsh"; then
        e_success "Done"
    else
        e_error "Failed to clone oh-my-zsh"
    fi
fi

e_header "Linking preferences..."

link_file "${DOTFILES}/zsh/zshrc" "${HOME}/.zshrc"
link_file "${DOTFILES}/ghostty" "${HOME}/.config/ghostty"
link_file "${DOTFILES}/ghostty/com.mitchellh.ghostty" "${HOME}/Library/Application Support/com.mitchellh.ghostty"
link_file "${DOTFILES}/TextMate/Bundles" "${HOME}/Library/Application Support/TextMate/Bundles"
link_file "${DOTFILES}/TextMate/Global.tmProperties" "${HOME}/Library/Application Support/TextMate/Global.tmProperties"
