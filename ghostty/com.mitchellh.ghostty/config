font-family = "Anonymice Powerline"
font-family-bold = "Anonymice Powerline Bold"
font-size = 18
font-thicken = true
font-thicken-strength = 20

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

window-decoration = true
window-padding-x = 2
window-padding-y = 2
window-height = 32
window-width = 90
window-padding-balance = true
window-save-state = always

theme = Mark

mouse-hide-while-typing = true
focus-follows-mouse = true
link-url = true

macos-icon = retro
link-previews = true

background-opacity = 0.9
background-blur = true

keybind = super+equal=unbind
keybind = super+c=copy_to_clipboard:plain
keybind = super+shift+c=copy_to_clipboard:vt
keybind = ctrl+super+c=copy_to_clipboard:html
